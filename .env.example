# Copie para .env.local (que está no .gitignore) e preencha.
# Em produção, tudo isso vive em Environment Variables da Vercel.

# ---- Público (vai para o bundle do cliente — nada sensível aqui) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Servidor apenas. NUNCA prefixar com NEXT_PUBLIC_. ----
# Contorna RLS. Usada em exatamente um arquivo: src/server/db/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=

# Embeddings para a memória semântica (Fase 5). Só necessário a partir dela.
# Provider atrás de interface em src/server/embeddings/. Default: Voyage AI.
VOYAGE_API_KEY=

# Override opcional de modelo por agente (ver src/server/llm/models.ts).
# MODEL_ORCHESTRATOR=claude-sonnet-5
# MODEL_BILLS=claude-haiku-4-5-20251001
# MODEL_TRANSACTIONS=claude-sonnet-5
# MODEL_TASKS=claude-haiku-4-5-20251001
# MODEL_MEMORY=claude-haiku-4-5-20251001
# MODEL_INSIGHTS=claude-opus-5

# ---- Somente para tests/rls/isolation.test.ts ----
# Aponte para um projeto Supabase DESCARTÁVEL, nunca o de produção.
# O teste cria e destrói dois households fictícios.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
